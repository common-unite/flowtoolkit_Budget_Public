<apex:page standardController="Budget"
           renderAs="pdf"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           applyHtmlTag="false"
           applyBodyTag="false">
    <html lang="en">
    <head>
        <title><apex:outputText value="{!Budget.Name}"/></title>
        <style>
            @page {
                size: letter portrait;
                margin: 0.6in 0.4in 0.6in 0.4in;

                @top-left {
                    content: "{!JSENCODE(Budget.Name)}";
                    font-family: Helvetica, sans-serif;
                    font-size: 9px;
                    color: #514f4d;
                }
                @bottom-right {
                    content: "Page " counter(page) " of " counter(pages);
                    font-family: Helvetica, sans-serif;
                    font-size: 9px;
                    color: #514f4d;
                }
            }

            .print-head {
                font-family: Helvetica, sans-serif;
                margin-bottom: 10px;
            }
            .print-head__title {
                font-size: 16px;
                font-weight: bold;
                color: #181818;
            }
            .print-head__sub {
                font-size: 10px;
                color: #514f4d;
                margin-top: 3px;
            }
        </style>
    </head>
    <body>
        <div class="print-head">
            <div class="print-head__title"><apex:outputText value="{!Budget.Name}"/></div>
            <apex:outputPanel layout="block" styleClass="print-head__sub" rendered="{!NOT(ISBLANK(Budget.Description))}"><apex:outputText value="{!Budget.Description}"/></apex:outputPanel>
        </div>
        <%%%NAMESPACE_OR_C%%%:BudgetSheet recordId="{!Budget.Id}"/>
    </body>
    </html>
</apex:page>
