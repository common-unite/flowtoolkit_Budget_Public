<apex:page standardController="BudgetPeriod"
           renderAs="pdf"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           applyHtmlTag="false"
           applyBodyTag="false">
    <html lang="en">
    <head>
        <title><apex:outputText value="{!BudgetPeriod.Name}"/></title>
        <style>
            @page {
                size: letter portrait;
                margin: 0.6in 0.4in 0.6in 0.4in;

                @top-left {
                    content: "{!JSENCODE(BudgetPeriod.Name)}";
                    font-family: Helvetica, sans-serif;
                    font-size: 9px;
                    color: #514f4d;
                }
                @bottom-right {
                    content: "Page " counter(page) " of " counter(pages);
                    font-family: Helvetica, sans-serif;
                    font-size: 9px;
                    color: #514f4d;
                }
            }

            .print-head {
                font-family: Helvetica, sans-serif;
                margin-bottom: 10px;
            }
            .print-head__title {
                font-size: 16px;
                font-weight: bold;
                color: #181818;
            }
            .print-head__lock {
                display: inline-block;
                margin-top: 5px;
                padding: 2px 7px;
                border: 1px solid #c9c7c5;
                border-radius: 9px;
                background-color: #f3f2f2;
                font-size: 9px;
                color: #514f4d;
            }
        </style>
    </head>
    <body>
        <div class="print-head">
            <div class="print-head__title">
                <apex:outputText value="{!$Label.Budget_Report_Title}">
                    <apex:param value="{!BudgetPeriod.Name}"/>
                </apex:outputText>
            </div>
            <apex:outputPanel layout="block" rendered="{!BudgetPeriod.IsSubmitted}">
                <span class="print-head__lock"><apex:outputText value="{!$Label.Budget_Report_Submitted}"/></span>
            </apex:outputPanel>
        </div>
        <c:BudgetSheet recordId="{!BudgetPeriod.Id}"/>
    </body>
    </html>
</apex:page>
