<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <assignments>
        <name>Stamp_Cell_Key</name>
        <label>Stamp Cell Key</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.%%%NAMESPACED_ORG%%%Cell_Key__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CellKey</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Stamps Cell Key (Budget Category | Budget Period | Grouping Identifier) when a Budget Category Value is created or moves to another cell. Cell Key is unique, so a second record for the same line item in the same period is rejected from any source: the grid, a Flow, Data Loader (#103). Records that existed before this flow keep a blank key until they move, so existing duplicates are never blocked from updating.</description>
    <environments>Default</environments>
    <formulas>
        <name>CellKey</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.%%%NAMESPACED_ORG%%%Grouping_Identifier__c}), NULL, {!$Record.BudgetCategoryId} &amp; &apos;|&apos; &amp; {!$Record.BudgetDivisionId} &amp; &apos;|&apos; &amp; LEFT({!$Record.%%%NAMESPACED_ORG%%%Grouping_Identifier__c}, 217))</expression>
    </formulas>
    <interviewLabel>BudgetCategoryValue (Before Save → Cell Key) {!$Flow.CurrentDateTime}</interviewLabel>
    <isOverridable>true</isOverridable>
    <label>BudgetCategoryValue (Before Save → Cell Key) | Overridable</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stamp_Cell_Key</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>false</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>ISNEW() || ISCHANGED({!$Record.BudgetCategoryId}) || ISCHANGED({!$Record.BudgetDivisionId}) || ISCHANGED({!$Record.%%%NAMESPACED_ORG%%%Grouping_Identifier__c})</filterFormula>
        <object>BudgetCategoryValue</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
