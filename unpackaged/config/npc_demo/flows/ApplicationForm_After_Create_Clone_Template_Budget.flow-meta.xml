<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Clone_Template_Budget</name>
        <label>Clone Template Budget</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>FlowToolKit__BudgetClone_Invocable</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Clone_Succeeded</targetReference>
        </connector>
        <dataTypeMappings>
            <typeName>T__budgetTemplate</typeName>
            <typeValue>Budget</typeValue>
        </dataTypeMappings>
        <dataTypeMappings>
            <typeName>U__record</typeName>
            <typeValue>Budget</typeValue>
        </dataTypeMappings>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>budgetTemplate</name>
            <value>
                <elementReference>budgetOverride</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>clonedBudget</assignToReference>
            <name>record</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>cloneSucceeded</assignToReference>
            <name>isSuccess</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <assignments>
        <name>Build_Budget_Override</name>
        <label>Build Budget Override</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>budgetOverride.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Funding_Opportunity.BudgetTemplateId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Requested_Amount_Set</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Requested_As_Maximum</name>
        <label>Set Requested As Maximum</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>budgetOverride.Maximum_Amount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.RequestedAmount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>budgetOverride.Requested_Amount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Clone_Template_Budget</targetReference>
        </connector>
    </assignments>
    <description>When an application form is created against a funding opportunity that carries a budget template, clones the template through the Flow Tool Kit Clone Budget action and stamps the new budget on the application form. The requested amount rides onto the clone as its MAXIMUM, because the ask arrives before the budget exists and becomes the ceiling the budget is built against; the template's own requested amount is zeroed on the clone so one overage is reported once rather than as both Over Requested and Over Max. The reference record is read with Get Records rather than a formula because ApplicationForm.ReferenceRecordId is polymorphic (Benefit, Funding Opportunity, Program); a reference to anything but an opportunity simply finds no template. Application forms created with a budget already set, or for opportunities without a template, are skipped. A clone failure never blocks the application form - the action returns Is Success false and the flow skips the stamp.</description>
    <environments>Default</environments>
    <isOverridable>true</isOverridable>
    <interviewLabel>ApplicationForm (After Create → Clone Template Budget) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ApplicationForm (After Create → Clone Template Budget) | Overridable</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <decisions>
        <name>Opportunity_Has_Template</name>
        <label>Opportunity Has Template?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No template - application form saves without a budget</defaultConnectorLabel>
        <rules>
            <name>Template_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Funding_Opportunity.BudgetTemplateId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Build_Budget_Override</targetReference>
            </connector>
            <label>Template found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Requested_Amount_Set</name>
        <label>Requested Amount Set?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No amount requested - clone keeps the template limits</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Clone_Template_Budget</targetReference>
        </defaultConnector>
        <rules>
            <name>Amount_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RequestedAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Requested_As_Maximum</targetReference>
            </connector>
            <label>Amount requested</label>
        </rules>
    </decisions>
    <decisions>
        <name>Clone_Succeeded</name>
        <label>Clone Succeeded?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Clone failed - application form saves without a budget</defaultConnectorLabel>
        <rules>
            <name>Clone_Committed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>cloneSucceeded</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_Cloned_Budget</targetReference>
            </connector>
            <label>Clone committed</label>
        </rules>
    </decisions>
    <recordLookups>
        <name>Get_Funding_Opportunity</name>
        <label>Get Funding Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Opportunity_Has_Template</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ReferenceRecordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>FundingOpportunity</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>BudgetTemplateId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Stamp_Cloned_Budget</name>
        <label>Stamp Cloned Budget</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>BudgetId</field>
            <value>
                <elementReference>clonedBudget.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Funding_Opportunity</targetReference>
        </connector>
        <filterFormula>AND(
  ISBLANK({!$Record.BudgetId}),
  NOT(ISBLANK({!$Record.ReferenceRecordId}))
)</filterFormula>
        <object>ApplicationForm</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>budgetOverride</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Budget</objectType>
    </variables>
    <variables>
        <name>cloneSucceeded</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>clonedBudget</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Budget</objectType>
    </variables>
</Flow>
